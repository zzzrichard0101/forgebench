{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgebench.dev/schema/failure-label.schema.json",
  "title": "ForgeBench Failure Label",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "primary_label",
    "contributing_labels",
    "evidence",
    "counterfactual",
    "reviewer_id",
    "reviewed_at",
    "confidence",
    "ambiguous"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 8 },
    "task_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "primary_label": { "$ref": "#/$defs/label" },
    "contributing_labels": {
      "type": "array",
      "items": { "$ref": "#/$defs/label" },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "id", "observation"],
        "properties": {
          "source": { "enum": ["trace", "grader", "manifest", "workspace_diff"] },
          "id": { "type": "string", "minLength": 1 },
          "observation": { "type": "string", "minLength": 10 }
        }
      }
    },
    "counterfactual": { "type": "string", "minLength": 10 },
    "reviewer_id": { "type": "string", "minLength": 2 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "confidence": { "enum": ["high", "medium", "low"] },
    "ambiguous": { "type": "boolean" },
    "notes": { "type": "string" }
  },
  "$defs": {
    "label": {
      "enum": [
        "planning",
        "context_memory",
        "tool",
        "verification",
        "recovery",
        "budget",
        "safety",
        "infrastructure",
        "task_grader"
      ]
    }
  }
}
