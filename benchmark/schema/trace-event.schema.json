{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgebench.dev/schema/trace-event.schema.json",
  "title": "ForgeBench Trace Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "sequence", "timestamp", "kind", "payload"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "format": "date-time" },
    "kind": {
      "enum": ["run_started", "model_action", "tool_result", "run_finished"]
    },
    "payload": { "type": "object" }
  }
}

