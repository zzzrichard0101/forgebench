  ],
  "cohorts": [
    "false_completion",
    "passing_control"
  ],
  "intervention_arms": [
    "no_intervention",
    "generic_review",
    "independent_reconstruction",
    "executable_diagnosis",
    "capability_gated"
  ],
  "screening": {
    "false_completion_clusters_min": 6,
    "passing_control_clusters_min": 6,
