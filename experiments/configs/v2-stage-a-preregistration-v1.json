    "repair_delta_vs_generic_review_min": 3,
    "passing_controls_retained_min": 14,
    "hard_safety_violations_max": 0,
    "single_mechanism_repair_share_max": 0.5,
    "complete_audit_manifest_required": true
  },
  "gate_unit": "task_cluster",
  "hidden_oracle_is_verifier_input": false,
  "stage_b_locked_until_gate_passes": true,
  "diagnosis_accuracy_requires_independent_blinded_labels": true,
  "primary_claim": "A capability-gated post-completion harness repairs diverse residual failures while safely abstaining on already-correct completions.",
  "research_positioning": {
    "novelty_is_not": [
      "generic model review",
      "diagnostic-first prompting alone",
      "probe-assisted repair alone"
    ],
    "candidate_contribution": "mechanism-validated repair capability as a prerequisite for selective verification allocation"
  }
